{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "www-andrewriley-info",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": [
    // Node.js APIs used by Next.js / OpenNext
    "nodejs_compat",
    // Allow server-side fetch() (Play page YouTube, sitemap, etc.)
    "global_fetch_strictly_public"
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "andrewriley.info",
      "custom_domain": true
    },
    {
      "pattern": "www.andrewriley.info",
      "custom_domain": true
    },
    {
      "pattern": "2026.andrewriley.info",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "images": {
    // Next.js <Image> via Cloudflare Images
    // https://opennext.js.org/cloudflare/howtos/image
    "binding": "IMAGES"
  },
  "services": [
    {
      // Required for ISR / revalidation (Play page revalidate = 3600)
      "binding": "WORKER_SELF_REFERENCE",
      "service": "www-andrewriley-info"
    }
  ],
  "env": {
    // Isolated preview Worker: workers.dev only — no production hostnames.
    // Deploy this branch with: npm run deploy:dev
    // Workers Builds preview command: npx opennextjs-cloudflare deploy --env=dev
    "dev": {
      "name": "www-andrewriley-info-dev",
      "workers_dev": true,
      "preview_urls": true,
      // Required: otherwise Wrangler inherits production custom domains
      // and would steal andrewriley.info / www / 2026 on deploy.
      "routes": [],
      "vars": {
        "ENVIRONMENT": "preview",
        "DESIGN_SYSTEM_REF": "andrewkriley/design-system@v0.1.0#therileys-team"
      },
      "observability": {
        "enabled": true
      },
      "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS"
      },
      "images": {
        "binding": "IMAGES"
      },
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "www-andrewriley-info-dev"
        }
      ]
    }
  }
}
